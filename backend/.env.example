# Copy to .env and load with your process manager, or export manually.

# CHATSTER_HTTP_ADDR=:8080
# If CHATSTER_HTTP_ADDR is unset, a numeric PORT is used when provided by a hosting platform.
# PORT=10000
# CHATSTER_DB_PATH=./chatster.db

# Storage backend. SQLite is the default; Postgres is opt-in and fails startup if unavailable.
# CHATSTER_STORAGE=sqlite
# CHATSTER_POSTGRES_DSN=postgres://chatster:password@db.example.com:5432/chatster?sslmode=verify-full
# CHATSTER_POSTGRES_MIN_CONNS=2
# CHATSTER_POSTGRES_MAX_CONNS=10

# Optional built frontend directory. Set in the single-service Docker image.
# CHATSTER_STATIC_DIR=../frontend/build

# Comma-separated browser Origins for HTTP credential requests and WebSocket upgrades.
# Required when CHATSTER_AUTH_MODE=session; empty allows all only in anonymous demo mode.
# CHATSTER_ALLOWED_ORIGINS=https://chat.example,https://admin.example

# Authentication defaults to the public anonymous demo. Session mode requires all values below.
# Keep the signing secret and provisioned tokens in a secret manager, never in this file.
# CHATSTER_AUTH_MODE=session
# CHATSTER_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Tokens must be 32-512 bytes; each user may receive up to 64 valid room grants.
# CHATSTER_AUTH_USERS_JSON=[{"token":"replace-with-32-to-512-random-bytes","user_id":"usr_alice","display_name":"Alice","rooms":["general","engineering"]}]
# CHATSTER_SESSION_TTL=1h
# Secure cookies are the default. Disable only for local HTTP development.
# CHATSTER_SESSION_COOKIE_SECURE=false

# Per-IP WebSocket upgrade rate limit (set to 0 to disable).
# CHATSTER_WS_UPGRADE_RPS=5
# CHATSTER_WS_UPGRADE_BURST=10

# Per-client chat message rate limit (set to 0 to disable).
# CHATSTER_MESSAGE_RPS=5
# CHATSTER_MESSAGE_BURST=10

# Optional startup cleanup for old persisted messages (0 or unset disables it).
# CHATSTER_MESSAGE_RETENTION_DAYS=30
# CHATSTER_AUDIT_RETENTION_DAYS=90
