# Optional: override WebSocket URL (production or custom dev)
# VITE_WS_URL=wss://api.example.com/ws

# Dev only: backend port when using default ws://127.0.0.1:<port>/ws
# VITE_WS_PORT=8080

# Optional: override the HTTP API origin when it is separate from the UI
# VITE_API_URL=https://api.example.com
# VITE_API_PORT=8080

# REACT_APP_* names remain accepted for existing local builds.
